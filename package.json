{
  "name": "remixer",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "author": "Given",
  "description": "Local producer workstation for audio analysis and AI stem separation",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "predev": "npm run build:mac-helper && npm run build:electron",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:icon": "node scripts/build-icon.mjs",
    "build:mac-runtime": "node scripts/prepare-mac-runtime.mjs",
    "build:windows-runtime": "node scripts/prepare-windows-runtime.mjs",
    "build:mac-helper": "node scripts/build-mac-helper.mjs",
    "build": "npm run build:electron && npm run build:renderer",
    "build:tutorial": "node scripts/prepare-tutorial-project.mjs",
    "package": "npm run build:tutorial && npm run build:icon && npm run build:mac-helper && npm run build && node scripts/package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wavesurfer.js": "7.12.11"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "ai.lumae.remixer",
    "productName": "Remixer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "worker",
        "to": "worker",
        "filter": ["**/*", "!**/__pycache__/**", "!**/.pytest_cache/**"]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": ["setup-engine.ps1", "setup-engine.sh"]
      },
      {
        "from": "build-tools/Down-So-Bad-Tutorial-Project.zip",
        "to": "tutorial/Down-So-Bad-Tutorial-Project.zip"
      }
    ],
    "asar": true,
    "win": {
      "target": ["nsis"],
      "icon": "build-tools/remixer-icon.png",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build-tools/windows-runtime",
          "to": "tools/windows-x64"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build-tools/remixer-icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "build-tools/remixer-file-clipboard",
          "to": "helpers/remixer-file-clipboard"
        },
        {
          "from": "build-tools/mac-runtime",
          "to": "tools/macos-arm64"
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
